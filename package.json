{
  "name": "facturacion-pos",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "preview": "npm --prefix web run preview",
    "electron:dev": "concurrently \"npm --prefix web run dev\" \"wait-on http://localhost:5180 && electron .\"",
    "electron:build": "node scripts/build.cjs",
    "electron:build:happydays": "node scripts/build.cjs"
  },
  "build": {
    "appId": "com.facturapos.app",
    "productName": "FacturaPOS",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "bin/**/*",
      "public/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "electron/fiscalBridge.ps1",
      "electron/lib/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "dir"
      ],
      "artifactName": "FacturaPOS-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "extraResources": [
      {
        "from": "bin/bridge_fiscal.exe",
        "to": "bridge_fiscal.exe"
      },
      {
        "from": "bin/cloudflared.exe",
        "to": "cloudflared.exe"
      }
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "express": "^5.3.0",
    "lucide-react": "^0.475.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "recharts": "^2.15.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.0",
    "vite": "^6.3.0",
    "wait-on": "^8.0.0"
  }
}
